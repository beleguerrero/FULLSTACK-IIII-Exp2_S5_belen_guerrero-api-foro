# Copy to .env and replace every placeholder locally. Do not commit populated .env files.
SPRING_PROFILES_ACTIVE=oracle
DB_URL=jdbc:oracle:thin:@replace-with-tns-alias
DB_USERNAME=replace-with-db-username
DB_PASSWORD=replace-with-db-password
ORACLE_TNS_ADMIN=replace-with-wallet-directory
JWT_SECRET=replace-with-base64-key-at-least-32-bytes
JWT_ISSUER=replace-with-jwt-issuer
JWT_AUDIENCE=replace-with-jwt-audience
